# ===========================================
# Frip & Co Street — configuration production
# ===========================================
#   cp .env.example .env   puis remplir TOUTES les valeurs CHANGER_MOI.
#   Ne JAMAIS commiter .env. Copie chiffrée hors ligne (gestionnaire de mots de passe).
#   Générer une clé : openssl rand -hex 32

# --- Base PostgreSQL (conteneur fripco-db, non publié sur l'hôte) ----------
# Rôle PROPRIÉTAIRE : migrations Alembic uniquement.
POSTGRES_USER=fripco
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort_64chars
POSTGRES_DB=fripco
# Rôle APPLICATIF non propriétaire (créé au 1er démarrage par docker/db-init) :
# il ne peut pas désactiver les triggers d'inaltérabilité.
FRIPCO_APP_USER=fripco_app
FRIPCO_APP_PASSWORD=CHANGER_MOI_autre_mot_de_passe_fort_64chars
# L'API se connecte avec le rôle applicatif…
DATABASE_URL=postgresql+asyncpg://fripco_app:CHANGER_MOI_autre_mot_de_passe_fort_64chars@db:5432/fripco
# …et les migrations avec le propriétaire.
MIGRATION_DATABASE_URL=postgresql+asyncpg://fripco:CHANGER_MOI_mot_de_passe_fort_64chars@db:5432/fripco

# --- Sécurité ---------------------------------------------------------------
ENVIRONMENT=production
# JWT (openssl rand -hex 32)
SECRET_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32
# Clé HMAC de chaînage (JET dès PR1, ventes/Z/clôtures en PR2). INDÉPENDANTE
# de SECRET_KEY, stable pour toute la vie de la boutique, archivée sous accès
# restreint : une rotation invaliderait la vérification de l'historique.
FISCAL_SIGNING_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32_independant
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Même origine (front et /api derrière app.lloomi.fr) : laisser vide.
CORS_ORIGINS=

# --- Application ------------------------------------------------------------
SHOP_NAME=Frip & Co Street
LOG_LEVEL=INFO
LOG_JSON=true
# Dossier des sauvegardes applicatives de la base (PR5) — dump `pg_dump | gzip`
# quotidien 03:00 Europe/Paris + déclenchement manuel (Administration >
# Sauvegardes). Sous le volume `fripco_data` en production (persiste les
# redéploiements) : docker/docker-compose.prod.yml monte ce volume sur
# `/app/data`, laisser la valeur relative par défaut.
BACKUP_DIR=data/backups
# Vide = URLs relatives (/api/...) — l'API est servie par le même domaine.
NEXT_PUBLIC_API_URL=

# --- Paiement CB — SumUp Solo (PR2) -----------------------------------------
# Push reader uniquement (pas de mode lien de paiement, D7) : sans TPE
# configuré ou hors ligne, la caisse n'accepte que les espèces. Secrets
# UNIQUEMENT ici (D12) — jamais saisis depuis l'admin, jamais dans
# app_settings. Une clé sup_sk_test_… est refusée si ENVIRONMENT=production.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_READER_ID=
# Racine de l'API SumUp, à ne changer que pour les tests (ex. un faux
# serveur local exerçant le flux complet push → poll → PAID → refund) —
# SANS suffixe de version, tous les chemins (v0.1/v2.1/v1.0) en dérivent.
SUMUP_API_BASE=https://api.sumup.com

# --- E-mail & newsletter — Brevo (PR3) --------------------------------------
# Compte Brevo PARTAGÉ avec la boutique de Vernon (Julien) : Frip & Co Street
# n'écrit JAMAIS sur la blocklist globale d'un contact ni ne supprime un
# contact Brevo (aucun DELETE /v3/contacts, aucun emailBlacklisted, E1) —
# uniquement sur SA liste dédiée ci-dessous.
BREVO_API_KEY=
# ID numérique de la liste Brevo dédiée « Frip & Co Street » (créée dans
# Brevo > Contacts > Listes — PAS la/les liste(s) de la boutique de Vernon).
BREVO_LIST_ID=
# Racine de l'API Brevo, à ne changer que pour les tests de bout en bout
# (faux serveur Brevo local) — laisser la valeur par défaut en production.
BREVO_API_BASE=https://api.brevo.com
# Token partagé authentifiant POST /api/brevo/webhook (query ?token=… ou
# header X-Brevo-Token) — sans lui, le webhook refuse tout événement (403,
# E9). Configurer la même valeur côté Brevo.
BREVO_WEBHOOK_TOKEN=
# Confirmation que le compte Brevo PARTAGÉ est basculé en suivi anonyme
# (recommandation CNIL 2026 sur le pixel d'ouverture individuel — l'API
# transactionnelle Brevo ne permet pas de le désactiver par message). Tant
# que cette valeur n'est pas à true, tout envoi via Brevo est refusé et
# retombe sur SMTP puis simulation (E6). QUESTION OUVERTE pour Julien tant
# que non vérifiée : le compte partagé est-il réellement en suivi anonyme ?
BREVO_ANONYMOUS_TRACKING=false
EMAIL_FROM_ADDRESS=noreply@fripco-street.fr
EMAIL_FROM_NAME=Frip & Co Street

# --- Météo locale (PR11, M3) ------------------------------------------------
# Clé OpenWeather (compte gratuit, api.openweathermap.org) affichant la météo
# du jour à côté du chiffre sur l'accueil et le cahier du jour. Facultative :
# sans elle la carte affiche « Météo indisponible » et rien d'autre ne change
# — aucune page ne tombe. C'est un SECRET : ici uniquement, jamais dans
# app_settings (l'écran Réglages n'expose que « clé configurée / absente »).
# La ville (et éventuellement lat/lon) se saisit dans Réglages > Météo.
OPENWEATHER_API_KEY=

# --- SMTP — repli si Brevo est absent ou refuse l'envoi (E6) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
