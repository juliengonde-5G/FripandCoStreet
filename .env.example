# ===========================================
# Frip & Co Street — configuration production
# ===========================================
#   cp .env.example .env   puis remplir TOUTES les valeurs CHANGER_MOI.
#   Ne JAMAIS commiter .env. Copie chiffrée hors ligne (gestionnaire de mots de passe).
#   Générer une clé : openssl rand -hex 32

# --- Base PostgreSQL (conteneur fripco-db, non publié sur l'hôte) ----------
# Rôle PROPRIÉTAIRE : migrations Alembic uniquement.
POSTGRES_USER=fripco
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort_64chars
POSTGRES_DB=fripco
# Rôle APPLICATIF non propriétaire (créé au 1er démarrage par docker/db-init) :
# il ne peut pas désactiver les triggers d'inaltérabilité.
FRIPCO_APP_USER=fripco_app
FRIPCO_APP_PASSWORD=CHANGER_MOI_autre_mot_de_passe_fort_64chars
# L'API se connecte avec le rôle applicatif…
DATABASE_URL=postgresql+asyncpg://fripco_app:CHANGER_MOI_autre_mot_de_passe_fort_64chars@db:5432/fripco
# …et les migrations avec le propriétaire.
MIGRATION_DATABASE_URL=postgresql+asyncpg://fripco:CHANGER_MOI_mot_de_passe_fort_64chars@db:5432/fripco

# --- Sécurité ---------------------------------------------------------------
ENVIRONMENT=production
# JWT (openssl rand -hex 32)
SECRET_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32
# Clé HMAC de chaînage (JET dès PR1, ventes/Z/clôtures en PR2). INDÉPENDANTE
# de SECRET_KEY, stable pour toute la vie de la boutique, archivée sous accès
# restreint : une rotation invaliderait la vérification de l'historique.
FISCAL_SIGNING_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32_independant
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Même origine (front et /api derrière street.fripco.fr) : laisser vide.
CORS_ORIGINS=

# --- Application ------------------------------------------------------------
SHOP_NAME=Frip & Co Street
LOG_LEVEL=INFO
LOG_JSON=true
# Vide = URLs relatives (/api/...) — l'API est servie par le même domaine.
NEXT_PUBLIC_API_URL=

# --- Paiement CB — SumUp Solo (PR2) -----------------------------------------
# Push reader uniquement (pas de mode lien de paiement, D7) : sans TPE
# configuré ou hors ligne, la caisse n'accepte que les espèces. Secrets
# UNIQUEMENT ici (D12) — jamais saisis depuis l'admin, jamais dans
# app_settings. Une clé sup_sk_test_… est refusée si ENVIRONMENT=production.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_READER_ID=
# Racine de l'API SumUp, à ne changer que pour les tests (ex. un faux
# serveur local exerçant le flux complet push → poll → PAID → refund) —
# SANS suffixe de version, tous les chemins (v0.1/v2.1/v1.0) en dérivent.
SUMUP_API_BASE=https://api.sumup.com

# --- Intégrations (arrivent en PR3, laisser vide pour l'instant) ------------
# BREVO_API_KEY=
# BREVO_LIST_EMAIL=
# BREVO_WEBHOOK_TOKEN=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
